    {
      "id": "claim_dc7ce5294126411bae38e613c4143a49",
      "statement": "hx_require_host (defined in hx-base.env) is the first call of every block: it compares hostname -s to the expected host and exits 10 on mismatch, then resolves HX_IP from hx-fleet-ips.env (generated from hx-fleet.tsv) and exits 10 if no IP is recorded. This sets the HX_HOST and HX_IP globals every later step reads, so a mistyped server name stops the build before any damage.",
      "evidence": [
        {
          "resource": "repo://docs/03-runbooks/common/01-base-admin-network-updates.sh#L9-L10",
