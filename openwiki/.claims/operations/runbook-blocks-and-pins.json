  "claims": [
    {
      "id": "claim_a9547819ac46468498a37e7f39ccb243",
      "statement": "The runbook system installs the fleet via numbered shell blocks under docs/03-runbooks/common/: 01 (identity/network/sudo/updates/disable-UFW/reboot), 02 (domain join + NVIDIA driver/reboot), 03 (inference-hosts-only Ollama), 04 (HX-4 reranker), 10-<app> (per-application install), and 90 (closed-server Ollama upgrade). All servers run 01 then 02, inference hosts add 03, HX-4 adds 04, then the application block; validation is two questions only: does it start and does it survive a reboot.",
      "evidence": [
        {
          "resource": "repo://docs/03-runbooks/RUN-SHEET.md#L51-L66",
          "version": "repo-lines-v1:sha256:fe6b7f1c8b01e64e0a36fbaf4f50f942d793e75a7e21a755962c5f34a0738bda:"
