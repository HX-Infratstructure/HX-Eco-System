    {
      "id": "claim_9136cb23695446c5b8652ece3fc604ce",
      "statement": "hx_ollama_install installs Ollama from a verified release archive with rollback: it renames the existing /usr/local/lib/ollama to ollama.previous, extracts into a fresh directory, restores the previous install on extraction failure (exit 30), and only removes .previous on success. This replaces the vendor installer which streams the archive into sudo tar as root with no checksum and deletes first, leaving a window with no Ollama to roll back to.",
      "evidence": [
        {
          "resource": "repo://docs/03-runbooks/common/90-ollama-upgrade.sh#L18-L43",
          "version": "repo-lines-v1:sha256:2f62380267aa1d47209d45cd512306d9674a9fa5ea33cf0200276a55e74bd6a0:"
