    {
      "id": "claim_fc15ab33750d4585a773ee271169bcfe",
      "statement": "hx-base.env is the single pin file: a sourced shell file (not YAML) holding foundation/LAN baseline, Ollama version+archive SHA, NVIDIA branch+pkg version, HX-4 reranker model+revision+runtime+port, and every fleet application pin with service ports. Its governing invariant is that changing a pin does not retro-change a closed server record; closed servers are upgraded separately and re-validated.",
      "evidence": [
        {
          "resource": "repo://docs/03-runbooks/common/hx-base.env#L1-L8",
          "version": "repo-lines-v1:sha256:48253e5d1118e3f76a2db93cfda25eaba4f0f3ce0836d6fd153c77b7c5f563c4:"
