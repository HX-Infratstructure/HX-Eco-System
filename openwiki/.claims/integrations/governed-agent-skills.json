    {
      "id": "claim_79e5e2d4b7f1430286b59ab283759b4d",
      "statement": "The architecture conflict rule enumerates what an external skill can never authorise, including moving a workload to another host, introducing a container platform, replacing native with vendor cloud or embedded deployment, changing gateway, DNS, domain, NTP, routing or topology, adding firewall or TLS restrictions without approval, repartitioning disks, changing shared model placement, changing permanent integration, and modifying PASS criteria during a run.",
      "evidence": [
        {
          "resource": "repo://skills/SKILL-GOVERNANCE.md#L124-L138",
          "version": "repo-lines-v1:sha256:3ba7a5abeee2b5192e87c295f0469fd06f6caa30f46221c840933ab588d25be2:"
        }
      ]
    },
