    },
    {
      "id": "claim_1538ff396ac94bc8b186a99fb435ee5c",
      "statement": "A component skill may assist with planning, native installation, configuration, troubleshooting, upgrades and migrations, diagnostics, validation preparation and interpreting a smoke-test failure, but grants no permission to change server assignments, networking, security policy, storage architecture, model placement, permanent integration or BASE PASS criteria.",
      "evidence": [
        {
          "resource": "repo://skills/README.md#L33-L44",
          "version": "repo-lines-v1:sha256:08fbd1c09f17193e885dd95414924453f4f0290d48af8d74196c98086df19a06:"
