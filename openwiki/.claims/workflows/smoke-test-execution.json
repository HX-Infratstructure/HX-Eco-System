    {
      "id": "claim_2bbb7710d94f4ae7a7ff2e655dfc5831",
      "statement": "hx-smoke-new refuses to start from an untracked or locally modified smoke-test authority (checks git ls-files, working-tree diff, staged diff), derives the proof step from hx-proof.tsv or requires it as an explicit fifth argument for shared companion authorities, binds the step to the run's host and authority, and records the repo commit SHA plus the procedure SHA-256 in the manifest.",
      "evidence": [
