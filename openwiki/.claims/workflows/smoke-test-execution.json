    {
      "id": "claim_41939a98e1b7438e853f7f54e22d3caa",
      "statement": "The build roadmap (deployment order, BASE PASS boundary) and the smoke roadmap (proof order, prior PASS evidence, permitted minimal temporary integration) are separate authorities; the smoke roadmap inherits the build roadmap and never authorizes a test before the SUT is installed/ready. A missing or not-yet-installed prerequisite yields NOT EXECUTABLE, not a FAIL or bypass.",
      "evidence": [
        {
          "resource": "repo://docs/00-control/HX-ECO-SYSTEM-SMOKE-TEST-ROADMAP.md#L12-L31",
          "version": "repo-lines-v1:sha256:5121dc85528228cdd0d05e961781732d69e2fd7ca23d1c7b959fc6074205e45f:"
        },
        {
