          "version": "repo-lines-v1:sha256:63c1969a965702c640b00530242de22632cee1274a3f6fc50bfb5b89209cbe48:"
        }
      ]
    },
    {
      "id": "claim_91ef928f7fad4477a881c0ea3a6e3f3c",
      "statement": "Smoke authority is layered so each document answers one question: the smoke-test roadmap = WHICH proof runs next; the smoke-testing operating model = HOW the validation subsystem fits; /smoke-tests/*.md = WHAT each component proves; the HX-5 smoke-test process = HOW HX executes/retains proof; the HX-5 CentCom runner toolset standard = the permanent client toolset; tools/hx-smoke-runner/ = the repository-owned implementation.",
      "evidence": [
        {
          "resource": "repo://docs/01-architecture/HX-SMOKE-TESTING-OPERATING-MODEL.md#L84-L99",
          "version": "repo-lines-v1:sha256:729042a9798f7264c77c8b70ed4703f570e11d616484eb45272bc71080aa592e:"
