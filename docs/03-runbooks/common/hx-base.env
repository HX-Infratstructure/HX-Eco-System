# shellcheck shell=bash
# shellcheck disable=SC2034  # sourced config; consumers are the 10-*.sh blocks
# HX common base-build pins and fleet facts.
# One place to change a version for every server not yet built.
#
# Changing a pin here does not retro-change a closed server record. If a closed
# server is upgraded, update its record and re-validate it.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Host -> IP map, generated from docs/00-control/hx-fleet.tsv.
# Edit the TSV, then run tools/hx-doc/hx-fleet.
# shellcheck source=./hx-fleet-ips.env
. "$SCRIPT_DIR/hx-fleet-ips.env"

# ---------------------------------------------------------------------------
# Foundation and LAN baseline
# ---------------------------------------------------------------------------
HX_DC_IP="192.168.50.200"
HX_GATEWAY="192.168.50.1"
HX_DOMAIN="hx.local.arpa"
HX_DOMAIN_TEST_USER="jarvisr@hx.local.arpa"

# ---------------------------------------------------------------------------
# Ollama - official install script only. Not Snap, not the Ubuntu archive.
# ---------------------------------------------------------------------------
# Fleet target. HX-2 and HX-3 closed on 0.33.3 and are upgraded to this by
# docs/03-runbooks/common/90-ollama-upgrade.sh.
HX_OLLAMA_VERSION="0.34.0"
# The Linux archive, from upstream's own published sha256sum.txt for v0.34.0.
# This is the artifact that actually lands on the server.
HX_OLLAMA_ARCHIVE_SHA256="cf95886728959aa09910bb34de5cca1cc5a8f68003b5597197d3f2c2d57c0804"

# ---------------------------------------------------------------------------
# NVIDIA driver - the one place the Ubuntu archive is allowed, because it is a
# driver and must match the running kernel ABI.
# ---------------------------------------------------------------------------
HX_NVIDIA_BRANCH="595"
HX_NVIDIA_PKG_VERSION="595.71.05-0ubuntu0.24.04.1"

# ---------------------------------------------------------------------------
# HX-4 shared retrieval plane
# ---------------------------------------------------------------------------
# Reranker checkpoint. BGE family, pinned to an immutable commit revision so a
# later upstream edit cannot silently change the model under a stable name.
# bge-reranker-v2-m3 is the M3-family cross-encoder that pairs with BGE-M3.
HX_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
HX_RERANKER_REVISION="953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e"

# Reranker serving runtime. Infinity, installed from PyPI, run under systemd.
# Chosen because it serves rerankers natively over HTTP with no container and
# no service code to write. Ollama does not serve cross-encoder rerankers.
HX_RERANKER_RUNTIME="infinity-emb"
HX_RERANKER_RUNTIME_VERSION="0.0.77"
HX_RERANKER_EXTRAS="torch,server"
HX_RERANKER_PORT="7997"
HX_RERANKER_HOST="0.0.0.0"
HX_RERANKER_VENV="/srv/reranker/venv"
HX_RERANKER_HOME="/srv/reranker"

# ---------------------------------------------------------------------------
# Shared helper: confirm we are on the intended server before doing anything.
# ---------------------------------------------------------------------------
hx_require_host() {
  local expected="$1"
  local actual; actual="$(hostname -s)"
  [ "$actual" = "$expected" ] || {
    echo "STOP: this block is for $expected but this host is $actual" >&2
    exit 10
  }
  HX_HOST="$expected"
  HX_IP="$(hx_ip_for "$expected")" || {
    echo "STOP: no IP recorded for $expected in docs/00-control/hx-fleet.tsv" >&2
    exit 10
  }
  printf '\n===== HX BASE BUILD: %s (%s) =====\n' "$HX_HOST" "$HX_IP"
}

# ---------------------------------------------------------------------------
# Shared helper: fetch an artifact and refuse it unless it matches its pin.
#
# .coderabbit.yaml states that a downloaded tarball or binary must verify a
# checksum. Only 10-postgresql.sh did. Everything else took whatever the
# server sent on the day, and a release asset can be replaced in place.
# ---------------------------------------------------------------------------
hx_fetch_verified() {
  local url="$1" dest="$2" want="$3"
  [ -n "$want" ] || {
    echo "STOP: no SHA-256 pin recorded for $url" >&2
    exit 30
  }
  curl -fsSL "$url" -o "$dest" || {
    rm -f "$dest"
    echo "STOP: could not download $url" >&2
    exit 30
  }
  echo "${want}  ${dest}" | sha256sum -c - >/dev/null || {
    echo "STOP: $url does not match its recorded SHA-256" >&2
    echo "      expected $want" >&2
    echo "      actual   $(sha256sum "$dest" | awk '{print $1}')" >&2
    # Do not leave an artifact that failed its check where a later step could
    # pick it up. The callers exit under set -e and clean up only on success.
    rm -f "$dest"
    exit 30
  }
  echo "Verified $(basename "$dest") against its pin."
}

# ---------------------------------------------------------------------------
# Shared helper: install a pinned Ollama from a verified release archive.
#
# The vendor installer cannot be given a local file. It streams the release
# archive straight into `sudo tar -x`, with no checksum, so verifying
# install.sh itself proved nothing about the 1.4 GB of binaries it then
# unpacks as root. This does what install.sh does, from an archive checked
# against upstream's own published sha256sum.txt: extract into /usr/local,
# create the service account, and write the same unit file.
# ---------------------------------------------------------------------------
hx_ollama_install() {
  local version="$1" sha="$2"
  # The install prefix is a variable only so the rollback path can be exercised
  # against a scratch directory. On a server it is always /usr/local.
  local prefix="${HX_OLLAMA_PREFIX:-/usr/local}"
  local url="https://github.com/ollama/ollama/releases/download/v${version}/ollama-linux-amd64.tar.zst"
  local tmp; tmp="$(mktemp -d)"

  # Extraction tool, not application software: the release archive is .tar.zst
  # and there is no .tgz for this version. Same category as tar and curl, and
  # the same allowance the other blocks use for build-essential and headers.
  command -v zstd >/dev/null 2>&1 || sudo apt install -y zstd   # tool, not application software
  hx_fetch_verified "$url" "$tmp/ollama.tar.zst" "$sha"

  # Keep the previous install until the new one is in place. The checksum
  # rules out a bad archive, but not a decompression, I/O or disk-space
  # failure part-way through extraction, and the vendor installer deletes
  # first: that window leaves an inference server with no Ollama and nothing
  # to go back to. A rename costs no extra space.
  sudo rm -rf "$prefix/lib/ollama.previous"
  if [ -d "$prefix/lib/ollama" ]; then
    sudo mv "$prefix/lib/ollama" "$prefix/lib/ollama.previous"
  fi
  sudo install -o0 -g0 -m755 -d "$prefix/bin" "$prefix/lib/ollama"
  if ! zstd -dc "$tmp/ollama.tar.zst" | sudo tar -xf - -C "$prefix"; then
    echo "STOP: extracting the Ollama archive failed." >&2
    sudo rm -rf "$prefix/lib/ollama"
    if [ -d "$prefix/lib/ollama.previous" ]; then
      sudo mv "$prefix/lib/ollama.previous" "$prefix/lib/ollama"
      echo "      the previous install was put back." >&2
    fi
    rm -rf "$tmp"
    exit 30
  fi
  sudo rm -rf "$prefix/lib/ollama.previous"
  rm -rf "$tmp"

  id ollama >/dev/null 2>&1 || \
    sudo useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
  # if/then, not `test && cmd`: under set -e a missing group would make the
  # && list return non-zero and abort the build.
  if getent group render >/dev/null 2>&1; then sudo usermod -a -G render ollama; fi
  if getent group video  >/dev/null 2>&1; then sudo usermod -a -G video  ollama; fi
  sudo usermod -a -G ollama "$(whoami)"

  # Byte-for-byte what the vendor installer writes, so the unit the fleet runs
  # does not change with this. Server-specific settings stay in the drop-in.
  sudo tee /etc/systemd/system/ollama.service >/dev/null <<EOF_OLLAMA_UNIT
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=$PATH"

[Install]
WantedBy=default.target
EOF_OLLAMA_UNIT
  sudo systemctl daemon-reload
}

# ---------------------------------------------------------------------------
# Application pins for the remaining fleet. Verified against upstream
# 2026-09-10. tools/hx-doc/hx-version-pins re-checks these.
#
# Source rule: applications come from PyPI, a GitHub release, a direct binary,
# or Hugging Face. The Ubuntu archive and Snap are for drivers only.
# ---------------------------------------------------------------------------

# HX-6 OmniRoute - MIT AI gateway, GitHub release
HX_OMNIROUTE_VERSION="3.8.50"

# HX-7 NGINX - upstream stable source tarball from nginx.org, built natively
HX_NGINX_VERSION="1.30.4"
# Computed from the published tarball 2026-09-10. nginx.org signs releases
# with PGP and publishes no checksum file, so this pin fixes the artifact
# this repository reviewed rather than restating an upstream hash.
HX_NGINX_SHA256="4261dc90e9e47c1c4041276e9aaa3d48ebe2e664f728e14fa95ae6c67d57a08b"

# HX-8 Open WebUI - PyPI
HX_OPEN_WEBUI_VERSION="0.11.3"

# HX-9 PostgreSQL - official source tarball from postgresql.org, built
# natively. Owner decision 2026-09-10: source build, not the PGDG repository.
HX_POSTGRES_MAJOR="18"
HX_POSTGRES_VERSION="18.6"
HX_POSTGRES_SHA256="555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f"

# HX-9 Redis - GitHub release source tarball, built natively
HX_REDIS_VERSION="8.10.1"
# From download.redis.io, the published release tarball. The GitHub tag
# archive used before is generated on request and its bytes are not
# guaranteed stable, so it cannot be pinned.
HX_REDIS_SHA256="60166c95ab7aedaa9dfe516de685be0a4dd87be95ded59ba429df14c13f1b663"

# HX-10 Qdrant - prebuilt Linux binary from the GitHub release
HX_QDRANT_VERSION="1.19.1"
# Computed from the release asset 2026-09-10.
HX_QDRANT_SHA256="eef986e769d4d3e806dd2d546e1b4ecdd416211e54d34b4ed764fac7c58e1085"

# HX-11 LightRAG - PyPI (package name differs from the project name)
HX_LIGHTRAG_VERSION="1.5.7"

# HX-12 Deep Agents - PyPI
HX_DEEPAGENTS_VERSION="0.7.13"

# HX-13 Mem0 - PyPI (OSS self-hosted)
HX_MEM0_VERSION="2.0.20"

# HX-14 n8n - npm, on Node.js installed from the official direct binary tarball
HX_NODE_VERSION="24.21.0"
HX_N8N_VERSION="2.38.6"

# HX-15 FastMCP - PyPI
HX_FASTMCP_VERSION="4.0.3"

# HX-16 Docling + Granite-Docling - PyPI and Hugging Face, CPU-first (D-006)
HX_DOCLING_VERSION="2.126.0"
HX_GRANITE_DOCLING_MODEL="ibm-granite/granite-docling-258M"
HX_GRANITE_DOCLING_REVISION="982fe3b40f2fa73c365bdb1bcacf6c81b7184bfe"

# HX-17 Crawl4AI - PyPI
HX_CRAWL4AI_VERSION="0.9.3"

# Service ports. All bind 0.0.0.0, matching the Ollama and reranker posture.
HX_OMNIROUTE_PORT="20128"   # OmniRoute default
HX_OPEN_WEBUI_PORT="8081"
HX_QDRANT_PORT="6333"
HX_LIGHTRAG_PORT="9621"
HX_N8N_PORT="5678"
HX_FASTMCP_PORT="8000"
