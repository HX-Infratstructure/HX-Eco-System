# HX common base-build pins and fleet facts.
# One place to change a version for every server that has not been built yet.
# Changing a pin here does NOT retro-change a closed server record; update the
# affected server record and re-validate if a closed server is upgraded.

# Foundation (HX-1) and LAN baseline.
HX_DC_IP="192.168.50.200"
HX_GATEWAY="192.168.50.1"
HX_DOMAIN="hx.local.arpa"
HX_DOMAIN_TEST_USER="jarvisr@hx.local.arpa"

# Fleet software baseline. HX-2 and HX-3 closed on these versions.
# Leave a value empty to accept the current archive/upstream release instead,
# and record the resolved version in that server's record before closing it.
HX_OLLAMA_VERSION="0.33.3"
HX_NVIDIA_BRANCH="595"
HX_NVIDIA_PKG_VERSION="595.71.05-0ubuntu0.24.04.1"

# host -> IP map. Keep in step with docs/00-control/CURRENT-STATE.md.
hx_ip_for() {
  case "$1" in
    hx-1)  echo "192.168.50.200" ;; hx-2)  echo "192.168.50.202" ;;
    hx-3)  echo "192.168.50.203" ;; hx-4)  echo "192.168.50.204" ;;
    hx-5)  echo "192.168.50.205" ;; hx-6)  echo "192.168.50.206" ;;
    hx-7)  echo "192.168.50.207" ;; hx-8)  echo "192.168.50.208" ;;
    hx-9)  echo "192.168.50.209" ;; hx-10) echo "192.168.50.210" ;;
    hx-11) echo "192.168.50.211" ;; hx-12) echo "192.168.50.212" ;;
    hx-13) echo "192.168.50.213" ;; hx-14) echo "192.168.50.214" ;;
    hx-15) echo "192.168.50.215" ;; hx-16) echo "192.168.50.216" ;;
    hx-17) echo "192.168.50.217" ;;
    *) return 1 ;;
  esac
}

# Every common block starts here: confirm we are on the intended server.
hx_require_host() {
  local expected="$1"
  local actual; actual="$(hostname -s)"
  [ "$actual" = "$expected" ] || {
    echo "STOP: this block is for $expected but this host is $actual" >&2
    exit 10
  }
  HX_HOST="$expected"
  HX_IP="$(hx_ip_for "$expected")" || {
    echo "STOP: no IP recorded for $expected in hx-base.env" >&2
    exit 10
  }
  printf '\n===== HX BASE BUILD: %s (%s) =====\n' "$HX_HOST" "$HX_IP"
}
