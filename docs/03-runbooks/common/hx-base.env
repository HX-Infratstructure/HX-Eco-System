# shellcheck shell=bash
# shellcheck disable=SC2034  # sourced config; consumers are the 10-*.sh blocks
# HX common base-build pins and fleet facts.
# One place to change a version for every server not yet built.
#
# Changing a pin here does not retro-change a closed server record. If a closed
# server is upgraded, update its record and re-validate it.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Host -> IP map, generated from docs/00-control/hx-fleet.tsv.
# Edit the TSV, then run tools/hx-doc/hx-fleet.
# shellcheck source=./hx-fleet-ips.env
. "$SCRIPT_DIR/hx-fleet-ips.env"

# ---------------------------------------------------------------------------
# Foundation and LAN baseline
# ---------------------------------------------------------------------------
HX_DC_IP="192.168.50.200"
HX_GATEWAY="192.168.50.1"
HX_DOMAIN="hx.local.arpa"
HX_DOMAIN_TEST_USER="jarvisr@hx.local.arpa"

# The fleet administers every host as one Linux account with one key. The
# fingerprint is the control: a host may hold other keys, but it must hold this
# one, and Block 1 refuses to continue without it. Validating "authorized_keys
# has a key" would have passed HX-2 and HX-3, which held the wrong one.
HX_ADMIN_USER="hxsa"
HX_FLEET_KEY_COMMENT="hx-fleet-20260810"
HX_FLEET_KEY_FINGERPRINT="SHA256:fpIJEHjkhRYRqnhvRhtgSqggOAjkTU90vSGWbh0vsPk"
# D-027: the public key ships with the runbooks so the install path is
# reviewable. The private half never leaves the operator workstation.
HX_FLEET_KEY_PUB="$SCRIPT_DIR/hx-fleet-key.pub"

# Fleet time authority. HX-1 is the only acceptable source; a public pool is a
# fallback, never the selection. The 2026-09-16 audit found three of four hosts
# synchronised to ntp.ubuntu.com with chrony not installed at all.
HX_NTP_SERVER="$HX_DC_IP"

# ---------------------------------------------------------------------------
# Ollama - official install script only. Not Snap, not the Ubuntu archive.
# ---------------------------------------------------------------------------
# Fleet target. HX-2 and HX-3 closed on 0.33.3 and are upgraded to this by
# docs/03-runbooks/common/90-ollama-upgrade.sh.
HX_OLLAMA_VERSION="0.34.0"
# The Linux archive, from upstream's own published sha256sum.txt for v0.34.0.
# This is the artifact that actually lands on the server.
HX_OLLAMA_ARCHIVE_SHA256="cf95886728959aa09910bb34de5cca1cc5a8f68003b5597197d3f2c2d57c0804"

# ---------------------------------------------------------------------------
# NVIDIA driver - the one place the Ubuntu archive is allowed, because it is a
# driver and must match the running kernel ABI.
# ---------------------------------------------------------------------------
HX_NVIDIA_BRANCH="595"
HX_NVIDIA_PKG_VERSION="595.91.07-0ubuntu0.24.04.1"

# ---------------------------------------------------------------------------
# HX-4 shared retrieval plane
# ---------------------------------------------------------------------------
# Reranker checkpoint. BGE family, pinned to an immutable commit revision so a
# later upstream edit cannot silently change the model under a stable name.
# bge-reranker-v2-m3 is the M3-family cross-encoder that pairs with BGE-M3.
HX_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
HX_RERANKER_REVISION="953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e"

# Meta-X generation model. Served by the Ollama installed in block 3.
# 05-gpt-oss.sh refuses to run while this is empty, for the same reason block 3
# refuses an unpinned Ollama. The tag is the source URI; the resolved blob
# digest is the artifact hash, and both go in the server record.
HX_GPT_OSS_MODEL="gpt-oss:20b"
HX_GPT_OSS_ALIAS="meta-x:gpt-oss-20b"

# Shared embedding plane (D-005).
# BGE-M3 primary at 1024 dimensions; explicit Ollama model tag. Nomic Embed
# Text v1.5 alternate at 768.
#
# The tag is the reviewed source reference, not the artifact. The resolved
# Ollama model ID and blob SHA-256 are captured at installation by
# hx_ollama_provenance and written into the HX-4 server record; that hash is
# the immutable identity. A closed record is never silently re-pulled or
# re-baselined against a later artifact under the same tag.
#
# The dimensions are the known-answer test 06-embeddings.sh runs: a wrong model
# answers with a vector of the wrong length, which is the one failure a health
# check never catches. It proves the D-005 identity, not the revision.
HX_EMBED_PRIMARY_MODEL="bge-m3:567m"
HX_EMBED_PRIMARY_ALIAS="hx-embed-primary:bge-m3"
HX_EMBED_PRIMARY_DIM="1024"
HX_EMBED_ALT_MODEL="nomic-embed-text:v1.5"
HX_EMBED_ALT_ALIAS="hx-embed-alt:nomic-v1.5"
HX_EMBED_ALT_DIM="768"

# Reranker serving runtime. Infinity, installed from PyPI, run under systemd.
# Chosen because it serves rerankers natively over HTTP with no container and
# no service code to write. Ollama does not serve cross-encoder rerankers.
HX_RERANKER_RUNTIME="infinity-emb"
HX_RERANKER_RUNTIME_VERSION="0.0.77"
HX_RERANKER_EXTRAS="torch,server"

# infinity-emb pins itself but not what it depends on, so pip takes whatever is
# current on build day. Two of those moved and broke the service on HX-4.
#
# click 8.2 changed how a secondary flag is validated. typer 0.12.5, which
# infinity installs, builds flags the new click rejects, so the CLI dies at
# argument parsing with "Secondary flag is not valid for non-boolean flag"
# before the server can start. Hold click below that change.
HX_RERANKER_CLICK_PIN="click<8.2"

# BetterTransformer is on by default and lives in optimum, which the torch
# extra does not install, so startup fails with "BetterTransformerManager is
# not defined". Installing an old optimum would be the wrong fix: infinity's
# own code says BetterTransformer does not work with torch >= 2.5, and the
# fleet runs 2.14. Turn the accelerator off instead.
HX_RERANKER_BETTERTRANSFORMER="false"
HX_RERANKER_PORT="7997"
HX_RERANKER_HOST="0.0.0.0"
HX_RERANKER_VENV="/srv/reranker/venv"
HX_RERANKER_HOME="/srv/reranker"

# ---------------------------------------------------------------------------
# Shared helper: confirm we are on the intended server before doing anything.
# ---------------------------------------------------------------------------
hx_require_host() {
  local expected="$1"
  local actual; actual="$(hostname -s)"
  [ "$actual" = "$expected" ] || {
    echo "STOP: this block is for $expected but this host is $actual" >&2
    exit 10
  }
  HX_HOST="$expected"
  HX_IP="$(hx_ip_for "$expected")" || {
    echo "STOP: no IP recorded for $expected in docs/00-control/hx-fleet.tsv" >&2
    exit 10
  }
  printf '\n===== HX BASE BUILD: %s (%s) =====\n' "$HX_HOST" "$HX_IP"
}

# ---------------------------------------------------------------------------
# Foundation gate helpers.
#
# Every check takes its inputs as arguments rather than reading the host, so
# tools/hx-doc/hx-gate-tests can prove each STOP fires without a server. A gate
# that cannot be shown to fail is not a gate.
#
# Exit codes 41-45 are reserved for the foundation gate. 10-15 and 20-25 are in
# use by the existing blocks.
# ---------------------------------------------------------------------------

# The host must answer with its fleet FQDN, not its short name. HX-2, HX-3 and
# HX-4 all returned the short name while their records implied otherwise.
hx_require_fqdn() {
  local actual="$1" expected="$2"
  [ "$actual" = "$expected" ] || {
    echo "STOP: hostname -f is '$actual', expected '$expected'." >&2
    echo "      Add the FQDN to the 127.0.1.1 line in /etc/hosts." >&2
    exit 41
  }
}

# HX-1 must be the selected source, not merely a configured one. chronyc marks
# the selected source with '^*'; a configured-but-unselected server shows '^-'.
# Is this server the one chrony selected? chronyc marks the selection with
# '^*'; a configured-but-unselected server shows '^-'. Quiet, and it returns
# rather than exits, because 00-foundation.sh has to test this and roll back
# rather than stop with the host's old time source already disabled.
hx_ntp_selected() {
  local sources="$1" server="$2"
  grep -qE "^\^\*[[:space:]]+${server//./\.}([[:space:]]|$)" <<<"$sources"
}

hx_require_ntp_source() {
  local sources="$1" server="$2"
  hx_ntp_selected "$sources" "$server" || {
    echo "STOP: $server is not the selected time source." >&2
    echo "      chronyc marks the selection with '^*'. Install chrony and set" >&2
    echo "      'server $server iburst prefer' if this host uses timesyncd." >&2
    exit 42
  }
}

# The approved fleet key must be present. Presence of *a* key is not the test.
hx_require_fleet_key() {
  local keyfile="$1" want="$2"
  [ -f "$keyfile" ] || {
    echo "STOP: $keyfile does not exist." >&2
    echo "      Run 00-foundation.sh before this block." >&2
    exit 43
  }
  local prints
  prints="$(ssh-keygen -lf "$keyfile" 2>/dev/null || true)"
  grep -qF "$want" <<<"$prints" || {
    echo "STOP: the approved HX fleet key is not in $keyfile." >&2
    echo "      Wanted $want" >&2
    exit 44
  }
}

# Ubuntu may carry SSH on the socket rather than the service. Either is
# acceptable; neither is not. Do not read a disabled ssh.service as a failure.
hx_require_ssh_persistence() {
  local svc="$1" sock="$2"
  [ "$svc" = "enabled" ] || [ "$sock" = "enabled" ] || {
    echo "STOP: neither ssh.service nor ssh.socket is enabled." >&2
    echo "      SSH would not return after a reboot." >&2
    exit 45
  }
}

# D-028: the NVIDIA branch is held at the Block 2 pin fleet-wide, so a driver
# move is an explicit change rather than a side effect of routine patching.
# The fleet already carries two driver states - the pin on most hosts, and
# 595.99.02 on HX-5 as the accepted HX5-F03 exception. Unmanaged upgrades
# would silently create a third.
#
# Takes the installed list as an argument, so the filter is testable without
# a machine that has NVIDIA packages on it.
hx_nvidia_hold_list() {
  local installed="$1" branch="$2"
  grep -E "nvidia.*-${branch}-server$" <<<"$installed" || true
}

# ---------------------------------------------------------------------------
# Shared helper: fetch an artifact and refuse it unless it matches its pin.
#
# .coderabbit.yaml states that a downloaded tarball or binary must verify a
# checksum. Only 10-postgresql.sh did. Everything else took whatever the
# server sent on the day, and a release asset can be replaced in place.
# ---------------------------------------------------------------------------
hx_fetch_verified() {
  local url="$1" dest="$2" want="$3"
  [ -n "$want" ] || {
    echo "STOP: no SHA-256 pin recorded for $url" >&2
    exit 30
  }
  curl -fsSL "$url" -o "$dest" || {
    rm -f "$dest"
    echo "STOP: could not download $url" >&2
    exit 30
  }
  echo "${want}  ${dest}" | sha256sum -c - >/dev/null || {
    echo "STOP: $url does not match its recorded SHA-256" >&2
    echo "      expected $want" >&2
    echo "      actual   $(sha256sum "$dest" | awk '{print $1}')" >&2
    # Do not leave an artifact that failed its check where a later step could
    # pick it up. The callers exit under set -e and clean up only on success.
    rm -f "$dest"
    exit 30
  }
  echo "Verified $(basename "$dest") against its pin."
}

# ---------------------------------------------------------------------------
# Shared helper: install a pinned Ollama from a verified release archive.
#
# The vendor installer cannot be given a local file. It streams the release
# archive straight into `sudo tar -x`, with no checksum, so verifying
# install.sh itself proved nothing about the 1.4 GB of binaries it then
# unpacks as root. This does what install.sh does, from an archive checked
# against upstream's own published sha256sum.txt: extract into /usr/local,
# create the service account, and write the same unit file.
# ---------------------------------------------------------------------------
hx_ollama_install() {
  local version="$1" sha="$2"
  # The install prefix is a variable only so the rollback path can be exercised
  # against a scratch directory. On a server it is always /usr/local.
  local prefix="${HX_OLLAMA_PREFIX:-/usr/local}"
  local url="https://github.com/ollama/ollama/releases/download/v${version}/ollama-linux-amd64.tar.zst"
  local tmp; tmp="$(mktemp -d)"

  # Extraction tool, not application software: the release archive is .tar.zst
  # and there is no .tgz for this version. Same category as tar and curl, and
  # the same allowance the other blocks use for build-essential and headers.
  command -v zstd >/dev/null 2>&1 || sudo apt install -y zstd   # tool, not application software
  hx_fetch_verified "$url" "$tmp/ollama.tar.zst" "$sha"

  # Keep the previous install until the new one is in place. The checksum
  # rules out a bad archive, but not a decompression, I/O or disk-space
  # failure part-way through extraction, and the vendor installer deletes
  # first: that window leaves an inference server with no Ollama and nothing
  # to go back to. A rename costs no extra space.
  sudo rm -rf "$prefix/lib/ollama.previous"
  if [ -d "$prefix/lib/ollama" ]; then
    sudo mv "$prefix/lib/ollama" "$prefix/lib/ollama.previous"
  fi
  sudo install -o0 -g0 -m755 -d "$prefix/bin" "$prefix/lib/ollama"
  if ! zstd -dc "$tmp/ollama.tar.zst" | sudo tar -xf - -C "$prefix"; then
    echo "STOP: extracting the Ollama archive failed." >&2
    sudo rm -rf "$prefix/lib/ollama"
    if [ -d "$prefix/lib/ollama.previous" ]; then
      sudo mv "$prefix/lib/ollama.previous" "$prefix/lib/ollama"
      echo "      the previous install was put back." >&2
    fi
    rm -rf "$tmp"
    exit 30
  fi
  sudo rm -rf "$prefix/lib/ollama.previous"
  rm -rf "$tmp"

  id ollama >/dev/null 2>&1 || \
    sudo useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
  # if/then, not `test && cmd`: under set -e a missing group would make the
  # && list return non-zero and abort the build.
  if getent group render >/dev/null 2>&1; then sudo usermod -a -G render ollama; fi
  if getent group video  >/dev/null 2>&1; then sudo usermod -a -G video  ollama; fi
  sudo usermod -a -G ollama "$(whoami)"

  # Byte-for-byte what the vendor installer writes, so the unit the fleet runs
  # does not change with this. Server-specific settings stay in the drop-in.
  sudo tee /etc/systemd/system/ollama.service >/dev/null <<EOF_OLLAMA_UNIT
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=$PATH"

[Install]
WantedBy=default.target
EOF_OLLAMA_UNIT
  sudo systemctl daemon-reload
}

# ---------------------------------------------------------------------------
# Shared helper: refuse a model reference that does not identify one artifact.
#
# `latest` is a name, not a pin. A re-pull after upstream moves gets a
# different model under the same name, silently. The dimension probe in
# 06-embeddings.sh catches a wrong family but not a same-dimension revision,
# so a floating tag would let a future BGE-M3 revision replace the one a closed
# server record names, with nothing in the build to notice.
#
# Same rule block 3 applies to Ollama itself: "whatever was current that day"
# is not a baseline a server record can state.
#
# hx_require_pinned_ref <variable-name>
# ---------------------------------------------------------------------------
hx_require_pinned_ref() {
  local name="$1" ref tag
  ref="${!name:-}"
  [ -n "$ref" ] || {
    echo "STOP: $name is not set in hx-base.env." >&2
    echo "      Record the verified upstream reference before build day." >&2
    exit 30
  }
  # No tag at all means :latest, so both spellings are the same defect.
  case "$ref" in
    *:*) tag="${ref##*:}" ;;
    *)   tag="latest" ;;
  esac
  [ "$tag" != "latest" ] || {
    echo "STOP: $name is \"$ref\"; \"latest\" is a floating tag, not a pin." >&2
    echo "      Record the fixed tag or digest reference actually reviewed," >&2
    echo "      then re-run this block. The dimension check cannot see a" >&2
    echo "      same-dimension revision change, so it does not cover this." >&2
    exit 31
  }
}

# ---------------------------------------------------------------------------
# Shared helper: print the provenance evidence for a pulled Ollama model.
#
# HX-2 and HX-3 both closed with an UNRESOLVED provenance field because the
# values were on screen at install time and nobody wrote them down. This emits
# all five template section 6 fields in the order the record wants them, so the
# evidence is captured while the pull transcript is still live.
#
# Each command's output is captured before awk reads it. `cmd | awk ... exit`
# closes the pipe early and kills the writer with SIGPIPE at 141, which
# pipefail turns into a failed assignment and `set -e` turns into an aborted
# block. `ollama show --modelfile` is the real risk: FROM is its first line and
# the licence text follows. Same defect as HX4-F01.
#
# hx_ollama_provenance <alias> <upstream-ref>
# ---------------------------------------------------------------------------
hx_ollama_provenance() {
  local alias="$1" ref="$2"
  local id blob listing modelfile
  listing="$(ollama list || true)"
  id="$(awk -v a="$alias" '$1 == a {print $2; exit}' <<<"$listing")"
  modelfile="$(ollama show --modelfile "$alias" 2>/dev/null || true)"
  blob="$(awk '/^FROM \// {print $2; exit}' <<<"$modelfile")"

  # An unknown value is recorded as UNRESOLVED, never omitted. `${blob##...}`
  # cannot do that on its own: on an empty blob it yields an empty string, and
  # on a path with no sha256- segment it yields the whole path back, which
  # would be printed under the Artifact SHA-256 label. Both are silently wrong
  # in a field the server record treats as evidence.
  local digest
  if [ -n "$blob" ] && [ "$blob" != "${blob##*/sha256-}" ]; then
    digest="${blob##*/sha256-}"
  else
    digest="UNRESOLVED"
  fi

  cat <<PROV

=== PROVENANCE — copy into docs/02-server-records/HX-4.md, section 6 ===
HX alias:          ${alias}
Upstream identity: ${ref}
Source URI:        ${ref}
Ollama model ID:   ${id:-UNRESOLVED}
Artifact SHA-256:  ${digest}
Import method:     ollama pull, then \`ollama cp\` to the HX alias
Blob path:         ${blob:-UNRESOLVED}
=========================================================================
PROV
}

# ---------------------------------------------------------------------------
# Application pins for the remaining fleet. Verified against upstream
# 2026-09-10. tools/hx-doc/hx-version-pins re-checks these.
#
# Source rule: applications come from PyPI, npm, a GitHub release, an upstream
# source tarball, a direct binary, or Hugging Face (README section 5, D-020).
# The Ubuntu archive is for the NVIDIA driver, build toolchains and library
# headers only. Snap is never permitted (D-021).
# ---------------------------------------------------------------------------

# HX-6 OmniRoute - MIT AI gateway, GitHub release
HX_OMNIROUTE_VERSION="3.8.50"

# HX-7 NGINX - upstream stable source tarball from nginx.org, built natively
HX_NGINX_VERSION="1.30.4"
# Computed from the published tarball 2026-09-10. nginx.org signs releases
# with PGP and publishes no checksum file, so this pin fixes the artifact
# this repository reviewed rather than restating an upstream hash.
HX_NGINX_SHA256="4261dc90e9e47c1c4041276e9aaa3d48ebe2e664f728e14fa95ae6c67d57a08b"

# HX-8 Open WebUI - PyPI
HX_OPEN_WEBUI_VERSION="0.11.3"

# HX-9 PostgreSQL - official source tarball from postgresql.org, built
# natively. Owner decision 2026-09-10: source build, not the PGDG repository.
# The LAN the fleet sits on. pg_hba.conf and anything else that needs the
# range reads it from here rather than repeating the literal.
HX_LAN_CIDR="192.168.50.0/24"

HX_POSTGRES_MAJOR="18"
HX_POSTGRES_VERSION="18.6"
HX_POSTGRES_SHA256="555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f"

# HX-9 Redis - GitHub release source tarball, built natively
HX_REDIS_VERSION="8.10.1"
# From download.redis.io, the published release tarball. The GitHub tag
# archive used before is generated on request and its bytes are not
# guaranteed stable, so it cannot be pinned.
HX_REDIS_SHA256="60166c95ab7aedaa9dfe516de685be0a4dd87be95ded59ba429df14c13f1b663"

# HX-10 Qdrant - prebuilt Linux binary from the GitHub release
HX_QDRANT_VERSION="1.19.1"
# Computed from the release asset 2026-09-10.
HX_QDRANT_SHA256="eef986e769d4d3e806dd2d546e1b4ecdd416211e54d34b4ed764fac7c58e1085"

# HX-11 LightRAG - PyPI (package name differs from the project name)
HX_LIGHTRAG_VERSION="1.5.7"

# HX-12 Deep Agents - PyPI
HX_DEEPAGENTS_VERSION="0.7.13"

# HX-13 Mem0 - PyPI (OSS self-hosted)
HX_MEM0_VERSION="2.0.20"

# HX-14 n8n - npm, on Node.js installed from the official direct binary tarball
HX_NODE_VERSION="24.21.0"
HX_N8N_VERSION="2.38.6"

# HX-15 FastMCP - PyPI
HX_FASTMCP_VERSION="4.0.3"

# HX-16 Docling + Granite-Docling - PyPI and Hugging Face, CPU-first (D-006)
HX_DOCLING_VERSION="2.126.0"
HX_GRANITE_DOCLING_MODEL="ibm-granite/granite-docling-258M"
HX_GRANITE_DOCLING_REVISION="982fe3b40f2fa73c365bdb1bcacf6c81b7184bfe"

# HX-17 Crawl4AI - PyPI
HX_CRAWL4AI_VERSION="0.9.3"
# Playwright decides which Chromium build lands, and it resolves and
# verifies that download itself. Pinning Playwright is what makes the
# browser reproducible; there is no stable archive URL for this repository
# to checksum on its own.
HX_PLAYWRIGHT_VERSION="1.62.0"

# Service ports. All bind 0.0.0.0, matching the Ollama and reranker posture.
HX_OMNIROUTE_PORT="20128"   # OmniRoute default
HX_OPEN_WEBUI_PORT="8081"
HX_QDRANT_PORT="6333"
HX_LIGHTRAG_PORT="9621"
HX_N8N_PORT="5678"
HX_FASTMCP_PORT="8000"
