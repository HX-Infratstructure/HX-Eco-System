#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  hx-smoke-promote <run-dir> <PASS|FAIL|NOT_EXECUTABLE>

Before promotion, normalize:
  evidence/result.txt    -> FUNCTIONAL=PASS|FAIL|NOT_EXECUTABLE
  cleanup/cleanup.txt    -> CLEANUP=PASS|NOT_APPLICABLE|FAIL

For PASS, manifest.md must also contain:
  prior_pass_evidence: <current evidence path(s)/accepted server record(s) or NONE>
  limited_integration_plan: <brief temporary integration plan or NONE>
USAGE
}

[[ $# -eq 2 ]] || { usage >&2; exit 2; }

# Runner-host gate.
# HX-5 CentCom is the standard station (D-014). Before CentCom activation
# (smoke roadmap A1-A4) there is no CentCom, so an operator station may be
# authorised explicitly by exporting HX_SMOKE_ALLOW_HOST=<hostname -s>.
# The station actually used is recorded in the run manifest.
RUNNER_HOST="$(hostname -s)"
if [[ "$RUNNER_HOST" != "hx-5" && "$RUNNER_HOST" != "${HX_SMOKE_ALLOW_HOST:-}" ]]; then
  echo "ERROR: ${0##*/} runs on HX-5 CentCom." >&2
  echo "       For pre-CentCom roadmap steps A1-A4, authorise this station with:" >&2
  echo "       export HX_SMOKE_ALLOW_HOST=$RUNNER_HOST" >&2
  exit 1
fi

RUN_DIR="$(readlink -f "$1")"
FINAL_STATUS="$2"
case "$FINAL_STATUS" in
  PASS|FAIL|NOT_EXECUTABLE) ;;
  *) echo "ERROR: invalid status: $FINAL_STATUS" >&2; exit 2 ;;
esac

HX_ECO_REPO="${HX_ECO_REPO:-$HOME/src/HX-Eco-System}"
HX_SMOKE_ROOT="$(readlink -f "${HX_SMOKE_ROOT:-$HOME/hx-smoke-runs}")"

case "$RUN_DIR/" in
  "$HX_SMOKE_ROOT"/*) ;;
  *) echo "ERROR: run directory is outside HX_SMOKE_ROOT." >&2; exit 1 ;;
esac

[[ -f "$RUN_DIR/manifest.md" ]] || { echo "ERROR: missing manifest.md" >&2; exit 1; }
[[ -f "$RUN_DIR/evidence/result.txt" ]] || { echo "ERROR: missing evidence/result.txt" >&2; exit 1; }
[[ -f "$RUN_DIR/cleanup/cleanup.txt" ]] || { echo "ERROR: missing cleanup/cleanup.txt" >&2; exit 1; }
[[ -d "$HX_ECO_REPO/.git" ]] || { echo "ERROR: HX_ECO_REPO is not a git checkout." >&2; exit 1; }

RUN_ID="$(awk -F': ' '$1=="run_id" {print $2; exit}' "$RUN_DIR/manifest.md")"
SUT_HOST="$(awk -F': ' '$1=="sut_host" {print $2; exit}' "$RUN_DIR/manifest.md")"
COMPONENT="$(awk -F': ' '$1=="component" {print $2; exit}' "$RUN_DIR/manifest.md")"
PRIOR_PASS_EVIDENCE="$(sed -n 's/^prior_pass_evidence:[[:space:]]*//p' "$RUN_DIR/manifest.md" | head -n 1)"
LIMITED_INTEGRATION_PLAN="$(sed -n 's/^limited_integration_plan:[[:space:]]*//p' "$RUN_DIR/manifest.md" | head -n 1)"

[[ -n "$RUN_ID" && -n "$SUT_HOST" && -n "$COMPONENT" ]] || {
  echo "ERROR: manifest is missing run_id, sut_host, or component." >&2
  exit 1
}

# AGENTS.md section 8: acceptance criteria must not change inside a run.
# Re-verify the procedure copy against the hash recorded by hx-smoke-new.
WANT_SHA="$(sed -n 's/^smoke_test_sha256:[[:space:]]*//p' "$RUN_DIR/manifest.md" | head -n 1)"
PROC_COPY="$(find "$RUN_DIR/procedure" -maxdepth 1 -name '*.md' -print -quit 2>/dev/null || true)"
[[ -n "$WANT_SHA" && "$WANT_SHA" != "TO_RECORD" ]] || {
  echo "ERROR: manifest has no smoke_test_sha256; run was not created by hx-smoke-new." >&2
  exit 1
}
[[ -n "$PROC_COPY" && -f "$PROC_COPY" ]] || {
  echo "ERROR: no procedure copy found in $RUN_DIR/procedure/." >&2
  exit 1
}
GOT_SHA="$(sha256sum "$PROC_COPY" | awk '{print $1}')"
[[ "$WANT_SHA" == "$GOT_SHA" ]] || {
  echo "ERROR: the smoke-test authority changed during this run." >&2
  echo "       recorded: $WANT_SHA" >&2
  echo "       actual:   $GOT_SHA" >&2
  echo "       Correct the authority in a reviewed repository change, then start a new run ID." >&2
  exit 1
}

FUNCTIONAL="$(awk -F= '$1=="FUNCTIONAL" {print $2; exit}' "$RUN_DIR/evidence/result.txt")"
CLEANUP="$(awk -F= '$1=="CLEANUP" {print $2; exit}' "$RUN_DIR/cleanup/cleanup.txt")"

if [[ "$FINAL_STATUS" == "PASS" ]]; then
  [[ "$FUNCTIONAL" == "PASS" ]] || { echo "ERROR: PASS requires FUNCTIONAL=PASS." >&2; exit 1; }
  [[ "$CLEANUP" == "PASS" || "$CLEANUP" == "NOT_APPLICABLE" ]] || {
    echo "ERROR: PASS requires CLEANUP=PASS or CLEANUP=NOT_APPLICABLE." >&2
    exit 1
  }
  [[ -n "$PRIOR_PASS_EVIDENCE" && "$PRIOR_PASS_EVIDENCE" != "TO_RECORD" ]] || {
    echo "ERROR: PASS requires prior_pass_evidence to be recorded (use NONE when not applicable)." >&2
    exit 1
  }
  [[ -n "$LIMITED_INTEGRATION_PLAN" && "$LIMITED_INTEGRATION_PLAN" != "TO_RECORD" ]] || {
    echo "ERROR: PASS requires limited_integration_plan to be recorded (use NONE when not applicable)." >&2
    exit 1
  }
  # Cumulative proof (D-016) says a downstream PASS rests on earlier accepted
  # proof. That was an honour system: this script checked only that
  # prior_pass_evidence was non-empty, never that the cited proof had passed.
  # The proof DAG in hx-proof.tsv now decides.
  PROOF_TSV="$HX_ECO_REPO/docs/00-control/hx-proof.tsv"
  PROOF_STEP="$(sed -n 's/^proof_step:[[:space:]]*//p' "$RUN_DIR/manifest.md" | head -n 1)"
  if [[ -f "$PROOF_TSV" && -n "$PROOF_STEP" && "$PROOF_STEP" != "NONE" ]]; then
    awk -F'\t' -v s="$PROOF_STEP" 'NR>1 && $1==s {found=1} END {exit !found}' "$PROOF_TSV" || {
      echo "ERROR: manifest names proof step '$PROOF_STEP', which is not in hx-proof.tsv." >&2
      exit 1
    }

    REQUIRES="$(awk -F'\t' -v s="$PROOF_STEP" 'NR>1 && $1==s {print $6}' "$PROOF_TSV")"
    if [[ -n "$REQUIRES" && "$REQUIRES" != "NONE" && "$REQUIRES" != "-" ]]; then
      IFS=',' read -r -a DEPS <<<"$REQUIRES"
      for dep in "${DEPS[@]}"; do
        dep="${dep// /}"
        [[ -n "$dep" ]] || continue
        dep_status="$(awk -F'\t' -v s="$dep" 'NR>1 && $1==s {print $8}' "$PROOF_TSV")"
        if [[ "$dep_status" != "PASS" ]]; then
          echo "ERROR: $PROOF_STEP requires $dep, which is '${dep_status:-unknown}', not PASS." >&2
          echo "       Cumulative proof: close $dep before promoting $PROOF_STEP." >&2
          echo "       Check with: tools/hx-doc/hx-proof --ready $PROOF_STEP" >&2
          exit 1
        fi
        if [[ "$PRIOR_PASS_EVIDENCE" != *"$dep"* ]]; then
          echo "ERROR: $PROOF_STEP requires $dep, but prior_pass_evidence does not cite it." >&2
          echo "       Recorded: $PRIOR_PASS_EVIDENCE" >&2
          echo "       Name the evidence that establishes $dep." >&2
          exit 1
        fi
      done
      echo "Prior proof satisfied: $PROOF_STEP requires $REQUIRES, all PASS and cited."
    fi
  fi

  # docs/05-evidence/README.md: every retained run must identify the component
  # version/revision, the system under test, and the transport/endpoint used.
  for field in component_version_or_revision transport_or_endpoint sut_ip; do
    value="$(sed -n "s/^${field}:[[:space:]]*//p" "$RUN_DIR/manifest.md" | head -n 1)"
    [[ -n "$value" && "$value" != "TO_RECORD" ]] || {
      echo "ERROR: PASS requires $field to be recorded in manifest.md (use NONE when genuinely not applicable)." >&2
      exit 1
    }
  done
fi

# Prevent obvious credentials from entering retained repository evidence.
if grep -RIE --exclude='*.png' --exclude='*.jpg' --exclude='*.jpeg' --exclude='*.webp' \
  '(ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|BEGIN [A-Z ]*PRIVATE KEY|Authorization:[[:space:]]*(Bearer|Basic)[[:space:]]+[^[:space:]]+|sshpass[[:space:]]+-p|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9_-]{20,}|(PASSWORD|PASSWD|SECRET|API_?KEY|TOKEN)[[:space:]]*[=:][[:space:]]*[^[:space:]]{6,})' \
  "$RUN_DIR/manifest.md" "$RUN_DIR/evidence" "$RUN_DIR/cleanup" >/dev/null; then
  echo "ERROR: possible secret detected in promotion set; redact before promotion." >&2
  exit 1
fi

UTC_END="$(date -u +%Y%m%dT%H%M%SZ)"
sed -i "s/^status: .*/status: $FINAL_STATUS/" "$RUN_DIR/manifest.md"
sed -i "s/^utc_end:.*/utc_end: $UTC_END/" "$RUN_DIR/manifest.md"
sed -i "s/^STATUS=.*/STATUS=$FINAL_STATUS/" "$RUN_DIR/evidence/result.txt"

DEST="$HX_ECO_REPO/docs/05-evidence/$SUT_HOST/$COMPONENT/$RUN_ID"
[[ ! -e "$DEST" ]] || { echo "ERROR: destination already exists: $DEST" >&2; exit 1; }

mkdir -p "$DEST"
cp "$RUN_DIR/manifest.md" "$DEST/manifest.md"
cp "$RUN_DIR/evidence/result.txt" "$DEST/result.txt"
cp "$RUN_DIR/cleanup/cleanup.txt" "$DEST/cleanup.txt"

if compgen -G "$RUN_DIR/evidence/supporting/*" >/dev/null; then
  mkdir -p "$DEST/supporting"
  cp -a "$RUN_DIR/evidence/supporting/." "$DEST/supporting/"
fi

cat > "$DEST/README.md" <<EOF_README
# Retained smoke-test evidence

- Run: $RUN_ID
- SUT: $SUT_HOST
- Component: $COMPONENT
- Final status: **$FINAL_STATUS**
- Prior PASS evidence: $PRIOR_PASS_EVIDENCE
- Limited integration plan: $LIMITED_INTEGRATION_PLAN

This bundle was promoted from HX-5 CentCom. Review the manifest, result, cleanup proof, dependency evidence references, and supporting captures before committing it.
EOF_README

printf 'PROMOTED=%s\n' "$DEST"
printf 'NEXT=review evidence, then commit explicitly; do not auto-commit from this script\n'
if [[ "$FINAL_STATUS" == "PASS" && -n "${PROOF_STEP:-}" && "$PROOF_STEP" != "NONE" ]]; then
  printf 'NEXT=set %s status to PASS in docs/00-control/hx-proof.tsv, then run tools/hx-doc/hx-proof\n' "$PROOF_STEP"
fi
