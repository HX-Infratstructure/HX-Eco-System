#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  hx-smoke-new <sut-host> <component> <smoke-test-file> [sut-ip] [proof-step]

Example:
  hx-smoke-new hx-9 postgresql postgresql-smoke-test.md 192.168.50.209

The proof step (B1, D3, ...) is derived from docs/00-control/hx-proof.tsv when
the host and authority identify exactly one step. Several steps share the
companion authority, so pass the id explicitly for those:

  hx-smoke-new hx-9 postgresql-mcp mcp-companion-smoke-test.md 192.168.50.209 B2
USAGE
}

[[ $# -ge 3 && $# -le 5 ]] || { usage >&2; exit 2; }

# Runner-host gate.
# HX-5 CentCom is the standard station (D-014). Before CentCom activation
# (smoke roadmap A1-A4) there is no CentCom, so an operator station may be
# authorised explicitly by exporting HX_SMOKE_ALLOW_HOST=<hostname -s>.
# The station actually used is recorded in the run manifest.
RUNNER_HOST="$(hostname -s)"
if [[ "$RUNNER_HOST" != "hx-5" && "$RUNNER_HOST" != "${HX_SMOKE_ALLOW_HOST:-}" ]]; then
  echo "ERROR: ${0##*/} runs on HX-5 CentCom." >&2
  echo "       For pre-CentCom roadmap steps A1-A4, authorise this station with:" >&2
  echo "       export HX_SMOKE_ALLOW_HOST=$RUNNER_HOST" >&2
  exit 1
fi

SUT_HOST="$1"
COMPONENT="$2"
TEST_FILE="$3"
SUT_IP="${4:-TO_RECORD}"
PROOF_STEP="${5:-}"

[[ "$SUT_HOST" =~ ^hx-[0-9]+$ ]] || { echo "ERROR: invalid SUT host: $SUT_HOST" >&2; exit 2; }
[[ "$COMPONENT" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "ERROR: invalid component slug: $COMPONENT" >&2; exit 2; }
[[ "$TEST_FILE" =~ ^[A-Za-z0-9._-]+\.md$ ]] || { echo "ERROR: smoke-test file must be a simple .md filename" >&2; exit 2; }

HX_ECO_REPO="${HX_ECO_REPO:-$HOME/src/HX-Eco-System}"
HX_SMOKE_ROOT="${HX_SMOKE_ROOT:-$HOME/hx-smoke-runs}"
PROC="$HX_ECO_REPO/smoke-tests/$TEST_FILE"

[[ -d "$HX_ECO_REPO/.git" ]] || { echo "ERROR: HX_ECO_REPO is not a git checkout: $HX_ECO_REPO" >&2; exit 1; }
[[ -f "$PROC" ]] || { echo "ERROR: smoke-test authority not found: $PROC" >&2; exit 1; }
git -C "$HX_ECO_REPO" ls-files --error-unmatch "smoke-tests/$TEST_FILE" >/dev/null 2>&1 || {
  echo "ERROR: smoke-test authority is not committed/tracked: smoke-tests/$TEST_FILE" >&2
  exit 1
}

git -C "$HX_ECO_REPO" diff --quiet -- "smoke-tests/$TEST_FILE" || {
  echo "ERROR: smoke-test authority has uncommitted changes; commit/revert before execution." >&2
  exit 1
}
git -C "$HX_ECO_REPO" diff --cached --quiet -- "smoke-tests/$TEST_FILE" || {
  echo "ERROR: smoke-test authority has staged but uncommitted changes; commit/revert before execution." >&2
  exit 1
}

# Resolve which proof step this run satisfies. hx-smoke-promote gates the
# PASS on the prior proofs this step declares, so the run has to name itself.
PROOF_TSV="$HX_ECO_REPO/docs/00-control/hx-proof.tsv"
if [[ -f "$PROOF_TSV" ]]; then
  if [[ -z "$PROOF_STEP" ]]; then
    mapfile -t CANDIDATES < <(
      awk -F'	' -v h="$SUT_HOST" -v a="smoke-tests/$TEST_FILE"         'NR>1 && $3==h && $5==a {print $1}' "$PROOF_TSV"
    )
    case ${#CANDIDATES[@]} in
      1) PROOF_STEP="${CANDIDATES[0]}"
         echo "Proof step: $PROOF_STEP (derived)" ;;
      0) echo "ERROR: no step in hx-proof.tsv for $SUT_HOST + smoke-tests/$TEST_FILE." >&2
         echo "       Add the step, or pass its id as the fifth argument." >&2
         exit 2 ;;
      *) echo "ERROR: ${#CANDIDATES[@]} steps match $SUT_HOST + smoke-tests/$TEST_FILE:" >&2
         printf '       %s
' "${CANDIDATES[@]}" >&2
         echo "       Pass the intended one as the fifth argument." >&2
         exit 2 ;;
    esac
  fi
  awk -F'	' -v s="$PROOF_STEP" 'NR>1 && $1==s {found=1} END {exit !found}' "$PROOF_TSV" || {
    echo "ERROR: '$PROOF_STEP' is not a step in hx-proof.tsv" >&2
    exit 2
  }
else
  PROOF_STEP="${PROOF_STEP:-NONE}"
fi

UTC="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_ID="${UTC}_${SUT_HOST}_${COMPONENT}"
RUN_DIR="$HX_SMOKE_ROOT/$RUN_ID"

umask 077
mkdir -p "$RUN_DIR"/{procedure,runner,fixtures,raw,evidence/supporting,cleanup}
cp "$PROC" "$RUN_DIR/procedure/$TEST_FILE"

REPO_COMMIT="$(git -C "$HX_ECO_REPO" rev-parse HEAD)"
PROC_SHA="$(sha256sum "$PROC" | awk '{print $1}')"
OPERATOR="${USER:-unknown}"

cat > "$RUN_DIR/manifest.md" <<EOF_MANIFEST
---
run_id: $RUN_ID
utc_start: $UTC
utc_end:
status: IN_PROGRESS
operator: $OPERATOR
runner_host: $RUNNER_HOST
sut_host: $SUT_HOST
sut_ip: $SUT_IP
component: $COMPONENT
proof_step: $PROOF_STEP
component_version_or_revision: TO_RECORD
smoke_test_file: smoke-tests/$TEST_FILE
smoke_test_repo_commit: $REPO_COMMIT
smoke_test_sha256: $PROC_SHA
transport_or_endpoint: TO_RECORD
known_answer: SEE_PROCEDURE
prior_pass_evidence: TO_RECORD
limited_integration_plan: TO_RECORD
validation_only_dependencies: SEE_PROCEDURE
cleanup_objects_expected: SEE_PROCEDURE
---

# HX Smoke-Test Run Manifest

Use the copied procedure in procedure/ as the acceptance authority for this run.

Before execution, replace:

- prior_pass_evidence: exact current retained evidence path(s)/accepted server record(s), or NONE;
- limited_integration_plan: brief temporary integration plan, or NONE.

Use \`docs/00-control/HX-ECO-SYSTEM-SMOKE-TEST-ROADMAP.md\` to determine required proof dependencies.
Do not place secrets in this manifest or retained evidence.
EOF_MANIFEST

cat > "$RUN_DIR/evidence/result.txt" <<'EOF_RESULT'
FUNCTIONAL=IN_PROGRESS
STATUS=IN_PROGRESS
SUMMARY=
EOF_RESULT

cat > "$RUN_DIR/cleanup/cleanup.txt" <<'EOF_CLEANUP'
CLEANUP=IN_PROGRESS
DETAIL=
EOF_CLEANUP

printf '%s\n' "$RUN_DIR"
